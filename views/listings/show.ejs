<% layout("/layouts/boilerplate") %>
<script>
  const mapToken = "<%= process.env.MAP_TOKEN %>";
</script>

<div class="row mt-3">
  <div class="col-8 offset-3">
    <h3><%= listing.title %>:</h3>
  </div>

  <div class="card col-6 offset-3 show-card listing-card">
    <img
      src="<%= listing.image.url %>"
      class="card-img-top show-img"
      alt="listing_image"
    />

    <div class="card-body">
      <% if(listing.owner){ %>
        <p class="card-text">
          owned by <i><%= listing.owner.username %></i>
        </p>
      <% } %>

      <p class="card-text"><%= listing.description %></p>
      <p class="card-text">&#8377; <%= listing.price.toLocaleString("en-IN")%></p>
      <p class="card-text"><%= listing.location %></p>
      <p class="card-text"><%= listing.country %></p>
    </div>
  </div>

  <% if(currUser && listing.owner && listing.owner._id.equals(currUser._id)) {%>
  <div class="btns">
    <a href="/listings/<%= listing._id %>/edit"
       class="btn btn-dark col-1 offset-3 edit-btn">Edit</a>

    <form method="POST" action="/listings/<%=listing._id%>?_method=DELETE">
      <button class="btn btn-dark offset-3">Delete</button>
    </form>
  </div>
  <% } %>

  <div class="col-8 offset-3 mb-3">
    <% if (currUser) { %>
    <hr>
    <h4>Leave a Review</h4>

    <form
      method="POST"
      action="/listings/<%= listing._id %>/reviews"
      class="needs-validation"
      novalidate
    >
      <div class="mb-3">
        <label class="form-label">Rating</label><br>
        <input type="radio" name="review[rating]" value="1" required> &#9733;
        <input type="radio" name="review[rating]" value="2"> &#9733;&#9733;
        <input type="radio" name="review[rating]" value="3"> &#9733;&#9733;&#9733;
        <input type="radio" name="review[rating]" value="4"> &#9733;&#9733;&#9733;&#9733;
        <input type="radio" name="review[rating]" value="5"> &#9733;&#9733;&#9733;&#9733;&#9733;
        <div class="invalid-feedback">Please give a rating between 1 and 5.</div>
      </div>

      <div class="mb-3">
        <label for="comment" class="form-label">Comment</label>
        <textarea
          name="review[comment]"
          id="comment"
          class="form-control"
          required
        ></textarea>
        <div class="invalid-feedback">Please write a review comment.</div>
      </div>

      <button class="btn btn-dark">Submit Review</button>
    </form>

    <hr>
    <% } %>

    <% if(listing.reviews.length > 0) { %>
    <div class="row">
      <p><b>All Reviews</b></p>

      <% for(review of listing.reviews) { %>
      <div class="card col-5 ms-3 mb-3">
        <div class="card-body">

          <% if(review.author){ %>
            <h5 class="card-title">@<%= review.author.username %></h5>
          <% } %>

          <p class="starability-result card-text"
             data-rating="<%= review.rating %>">
            Rated: <%= review.rating %> stars
          </p>

          <p class="card-text"><%= review.comment %></p>
          <p class="card-text">Rating: <%= review.rating %> &#11088;</p>

          <form class="mb-3"
                method="Post"
                action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
            <button class="btn btn-sm btn-dark">Delete</button>
          </form>

        </div>
      </div>
      <% } %>
    </div>
    <% } %>
  </div>

  <div class="col-6 offset-3">
    <div id="map"></div>
  </div>
</div>

<script src="/js/map.js"></script>
